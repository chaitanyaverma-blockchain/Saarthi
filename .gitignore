# ==========================================
# SAARTHI - Git Ignore Rules
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# Python virtual environments & bytecode
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
pkgs/
backend/pkgs/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Django local database & static/media uploads
*.sqlite3
db.sqlite3
db.sqlite3-journal
backend/db.sqlite3
backend/db.sqlite3-journal
/media/
backend/media/
media/*
!media/.gitkeep
backend/media/*
!backend/media/.gitkeep
/staticfiles/
backend/staticfiles/

# Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.pnpm-store/
.npm
.eslintcache
.stylelintcache

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
