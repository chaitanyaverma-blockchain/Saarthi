# SAARTHI Backend Environment Configuration (Template)
# Copy this file to `saarthi/backend/.env` and update the values for your environment.

# Django Settings
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite if USE_POSTGRES=False)
USE_POSTGRES=False
# POSTGRES_DB=saarthi_db
# POSTGRES_USER=saarthi_user
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini AI Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
