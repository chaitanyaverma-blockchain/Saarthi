# SAARTHI Backend Environment Configuration (Template)
# Copy this file to `.env` in this directory for local development.

DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# Production Database (Render / Supabase / Neon PostgreSQL)
# Leave blank for local SQLite (db.sqlite3)
# DATABASE_URL=postgresql://user:password@host:port/dbname

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app,https://*.onrender.com

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

MAX_UPLOAD_SIZE_MB=10
SECURE_SSL_REDIRECT=True
