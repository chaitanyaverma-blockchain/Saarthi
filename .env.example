# SAARTHI Backend Environment Configuration (Template)
# Copy this file to `saarthi/backend/.env` for local development.
# In production (Render), set these in the Render Environment Variables Dashboard.

# Django Security & Debug
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# Production Database (Render / Supabase / Neon PostgreSQL)
# In development, leave blank to automatically use local SQLite (db.sqlite3)
# In production, Render automatically provides this connection string:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS & CSRF Configuration
# Comma-separated list of allowed frontend origins (e.g. your Vercel URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app,https://*.onrender.com

# Google Gemini AI Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10

# HTTPS Settings (Production)
SECURE_SSL_REDIRECT=True
