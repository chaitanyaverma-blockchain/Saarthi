# SAARTHI Backend Environment Configuration (Template)
# Copy this file to `.env` in this directory and update with your credentials.

DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite default)
USE_POSTGRES=False
# POSTGRES_DB=saarthi_db
# POSTGRES_USER=saarthi_user
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

MAX_UPLOAD_SIZE_MB=10
